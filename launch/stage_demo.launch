<launch>
  <arg name="gui" default="true"/>
  <arg name="world" default="$(find collision_avoidance)/worlds/avoidance.world"/>
  <param name="use_sim_time" value="true"/>
  <node if="$(arg gui)" pkg="stage_ros" type="stageros" name="stage" args="$(arg world)" output="screen" required="true"/>
  <node unless="$(arg gui)" pkg="stage_ros" type="stageros" name="stage" args="-g $(arg world)" output="screen" required="true"/>
  <include file="$(find collision_avoidance)/launch/avoidance.launch"/>
</launch>
